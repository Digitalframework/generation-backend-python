# AuthAndSecurity — signs the access tokens and owns the user table.
AUTH_BASE_URL=http://localhost:8080

# Derived from AUTH_BASE_URL unless set explicitly.
# JWKS_URI=http://localhost:8080/.well-known/jwks.json
# JWT_ISSUER=http://localhost:8080

# Must equal app.jwt.audience in AuthAndSecurity. If this service is given an
# audience of its own, that property has to become a list over there first —
# see the README.
JWT_AUDIENCE=generation-backend

# Balance endpoints on AuthAndSecurity (see README — they need adding there).
BALANCE_PATH=/api/tokens/balance
SPEND_PATH=/api/tokens/spend

# --- FLUX.2, hosted at Black Forest Labs -------------------------------------
# Key from https://dashboard.bfl.ai. Without it /api/generate answers 503.
FLUX_API_KEY=
FLUX_API_URL=https://api.bfl.ai/v1/flux-2-pro
FLUX_ASPECT_RATIO=1:1
FLUX_OUTPUT_FORMAT=png
FLUX_REFERENCE_MAX_EDGE=1024
FLUX_TIMEOUT=180
FLUX_POLL_INTERVAL=0.5

# Pricing: base cost plus a surcharge per reference image.
TOKENS_PER_GENERATION=5
TOKENS_PER_REFERENCE=1
TOKENS_PER_OBJECT=1

# --- Generation jobs ---------------------------------------------------------
# POST /api/generate answers 202 {jobId}; poll GET /api/jobs/<jobId>.
#   local   thread pool in this process — default, nothing else to run
#   inline  finishes the job before answering (debugging)
#   cloud   Google Cloud Tasks -> POST WORKER_URL/internal/jobs/run
TASKS_MODE=local
LOCAL_WORKER_THREADS=2
# Defaults follow TASKS_MODE: file + local for local/inline, firestore + gcs for cloud.
# JOB_STORE=file
# STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/jobs

# --- Google Cloud (TASKS_MODE=cloud) ------------------------------------------
# GCP_PROJECT=my-project
# GCP_LOCATION=europe-west3
# TASKS_QUEUE=generate-jobs
# WORKER_URL=https://imagegen-worker-xxxxx.europe-west3.run.app
# TASKS_SERVICE_ACCOUNT=tasks-invoker@my-project.iam.gserviceaccount.com
# TASKS_OIDC_AUDIENCE=            # defaults to WORKER_URL
# TASKS_MAX_ATTEMPTS=3            # keep equal to the queue's --max-attempts
# TASKS_DISPATCH_DEADLINE=900
# GCS_BUCKET=innigo-generation-jobs
# FIRESTORE_COLLECTION=generation_jobs

JWT_LEEWAY=30
HTTP_TIMEOUT=5
HTTP_RETRIES=2
BALANCE_CACHE_TTL=3

FLASK_DEBUG=0
