# AuthAndSecurity — signs the access tokens and owns the user table.
AUTH_BASE_URL=http://localhost:8080

# Derived from AUTH_BASE_URL unless set explicitly.
# JWKS_URI=http://localhost:8080/.well-known/jwks.json
# JWT_ISSUER=http://localhost:8080

# Must equal app.jwt.audience in AuthAndSecurity. If this service is given an
# audience of its own, that property has to become a list over there first —
# see the README.
JWT_AUDIENCE=generation-backend

# Balance endpoints on AuthAndSecurity (see README — they need adding there).
BALANCE_PATH=/api/tokens/balance
SPEND_PATH=/api/tokens/spend

# --- FLUX.2, hosted at Black Forest Labs -------------------------------------
# Key from https://dashboard.bfl.ai. Without it /api/generate answers 503.
FLUX_API_KEY=
FLUX_API_URL=https://api.bfl.ai/v1/flux-2-pro
FLUX_ASPECT_RATIO=1:1
FLUX_OUTPUT_FORMAT=png
FLUX_REFERENCE_MAX_EDGE=1024
FLUX_TIMEOUT=180
FLUX_POLL_INTERVAL=0.5

# Pricing: base cost plus a surcharge per reference image.
TOKENS_PER_GENERATION=5
TOKENS_PER_REFERENCE=1
TOKENS_PER_OBJECT=1

JWT_LEEWAY=30
HTTP_TIMEOUT=5
HTTP_RETRIES=2
BALANCE_CACHE_TTL=3

FLASK_DEBUG=0
